      "b1_economy_max": 5.0,
      "b2_timing_max": 10.0,
      "b1_ideal_dispatches": 7,
      "b1_max_dispatches": 14,
      "b1_ideal_first_pass_ratio": 0.70,
      "b1_floor_first_pass_ratio": 0.35,
      "b1_smuggling_penalty": 0.5,
      "b1_midflight_contract_penalty": 0.5,
      "b1_tool_error_penalty": 0.25,
      "b2_free_min": 6.0,
      "b2_halflife_min": 8.0,
