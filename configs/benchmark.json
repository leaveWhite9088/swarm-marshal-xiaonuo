{
  "benchmark_id": "swarm-marshal-xiaonuo",
  "version": "xiaonuo-v1.0",
  "title": "群智统帅 · 架构拆解与团队统领基准",
  "worker_harness": {
    "mode": "pi",
    "harness": "pi",
    "pi": {
      "provider": "provider",
      "model": "DeepSeek-V4.1-Flash-1017",
      "thinking": "off",
      "temperature": 0.1,
      "max_context_tokens": 32000,
      "compact_at_tokens": 24000,
      "timeout_sec": 240,
      "reply_char_limit": 6000,
      "custom_endpoint": {
        "enabled": false,
        "base_url": "",
        "api_key_env": "SWARM_WORKER_API_KEY",
        "api": "openai-completions"
      }
    },
    "openai_fallback": {
      "base_url_env": "SWARM_WORKER_BASE_URL",
      "api_key_env": "SWARM_WORKER_API_KEY",
      "model": "DeepSeek-V4.1-Flash-1017",
      "temperature": 0.1,
      "max_tokens": 4096,
      "timeout_sec": 180
    },
    "mock": {
      "deterministic": true,
      "min_contract_chars_for_alignment": 320,
      "overload_rule_clusters": 4,
      "overload_ticket_chars": 1500
    }
  },
  "marshal_limits": {
    "max_workers": 5,
    "max_files_per_worker": 4,
    "max_dispatches": 14,
    "max_dispatches_per_worker": 5,
    "max_reworks_per_ticket": 2,
    "max_ticket_chars": 4000,
    "max_role_prompt_chars": 2500,
    "max_contract_chars": 15000,
    "max_review_comment_chars": 2500,
    "allowed_root_prefixes": [
      "cloudhub/",
      "tests/"
    ],
    "protected_paths": [
      "TASK.md",
      "smoke_public.py",
      "GLOBAL_CONTRACT.md"
    ],
    "code_smuggling": {
      "max_consecutive_code_lines": 7,
      "max_total_impl_lines_ticket": 12,
      "max_total_impl_lines_contract": 10,
      "max_impl_line_ratio": 0.28
    }
  },
  "scoring": {
